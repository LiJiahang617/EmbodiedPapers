# Obsidian local UI/runtime state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css
.obsidian/plugins/*/*.map
.obsidian/plugins/obsidian-git/obsidian_askpass.sh
.obsidian/themes/*/theme.css

# ==================== 论文库同步策略 ======================
# 同步「小文本笔记」：文献笔记 papers/@*.md、中英混读精读稿 papers/bilingual/*.md、
# 论文地图、setting 配置、AGENTS.md。
# 不同步「大文件」：PDF（papers/pdfs）与图片（papers/images）全部本地化，
# 避免仓库随论文增多而膨胀；笔记里指向 PDF/图片的链接在远端仅作占位。
papers/*
!papers/.gitkeep
# 文献笔记（含论文名/元数据）是小文本，进 Git
!papers/@*.md
!papers/pdfs/
papers/pdfs/*
!papers/pdfs/.gitkeep
!papers/images/
papers/images/*
!papers/images/.gitkeep
!papers/readings/
papers/readings/*
!papers/readings/.gitkeep
!papers/bilingual/
papers/bilingual/*
!papers/bilingual/.gitkeep
# 中英混读精读稿是小文本，进 Git（PDF/图片不进）
!papers/bilingual/*.md

institutions/*
!institutions/.gitkeep

researchers/*
!researchers/.gitkeep
