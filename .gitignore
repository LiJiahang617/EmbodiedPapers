local-archive/
terminals/
.claude/
.agents/
.claudian/
agent-tools/

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Nested independent repos (own .git; not tracked by this repo)
Embodied-AI-Daily/
robotics_arXiv_daily/
